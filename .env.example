# ============================================================
# firefly-gen 环境变量示例。复制为 .env 后填写，切勿提交 .env。
# ============================================================

# ---- 应用 ----
APP_ENV=dev                     # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-32-bytes-random   # JWT 签名密钥，生产必须随机
APP_BASE_URL=http://127.0.0.1:8000

# ---- 数据库 (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://firefly:firefly@127.0.0.1:5432/firefly_gen
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Redis (缓存 / 队列 / 分布式锁 / ARP 池) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Celery / 任务队列 ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
GEN_WORKER_CONCURRENCY=32        # 出图/出视频 worker 并发协程数

# ---- ARP 池 (内部服务鉴权) ----
ARP_INTERNAL_TOKEN=change-me-internal-token   # 采集器 → ARP 服务 的内网密钥
ARP_TTL_SECONDS=120              # ARP 入池后视为有效的时间（建议 < 真实 TTL 2~4min）
ARP_MIN_READY=3                  # 池水位低于该值时暂停/降速出图
ARP_MAX_USES=20                  # 单枚 ARP 最大复用次数，408 立即作废

# ---- 采集器 (harvester，独立进程) ----
HARVESTER_TARGET=http://127.0.0.1:8000     # ARP 服务地址（本平台 admin-api）
ARP_INTERVAL=75                  # 铸票间隔秒，必须 < ARP 真实 TTL
HEADLESS=1
# CloakBrowser PRO / fingerprint-chromium 148 可执行文件路径
ADOBE_CHROME_BINARY=
ADOBE_CHROME_ARGS=--fingerprint={seed} --fingerprint-platform=windows --fingerprint-brand=Chrome --lang=en-US --accept-lang=en-US,en;q=0.9 --window-size=1366,768
# 住宅 sticky 代理，逗号分隔；铸票走这些出口，提交必须绑定同一出口
ARP_PROXIES=

# ---- 上游账号池 (Adobe Firefly，HARD 付费号) ----
# 账号数据不入库明文，走加密存储；此处仅示例导入路径
ACCOUNTS_IMPORT_PATH=

# ---- 出图提交默认 ----
SUBMIT_IMPERSONATE=chrome131     # curl_cffi impersonate profile（TLS 模拟）
POLL_TIMEOUT_SECONDS=120
DOWNLOAD_VIA_PROXY=0             # 预签名 CDN 建议直连（0），住宅代理拉大图易超时

# ---- 对象存储 (生成结果，可选 S3/MinIO) ----
STORAGE_BACKEND=local            # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
